{
  "name": "writing-calendar",
  "version": "0.3.12",
  "description": "Local-first writing activity calendar and analytics for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "deploy": "npm run check && node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "writing",
    "calendar",
    "statistics"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
